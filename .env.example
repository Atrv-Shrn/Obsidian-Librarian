# Obsidian-Librarian — environment template.
# Copy to `.env` and fill in. Only API keys are truly required to run.

# --- Ollama Cloud (LLM + judge) -------------------------------------------
# Native Ollama API host — ChatOllama appends /api/chat. Do NOT add a /v1 suffix
# (that is the OpenAI-compat path; it 404s on /v1/api/chat). One key routes both models.
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_API_KEY=replace-me
GENERATION_MODEL=deepseek-v4-pro:cloud
JUDGE_MODEL=glm-5.2:cloud

# --- Local Ollama (embeddings, in-container) ------------------------------
OLLAMA_LOCAL_BASE_URL=http://127.0.0.1:11434
EMBED_MODEL=nomic-embed-text

# --- Paths (INSIDE the container) -----------------------------------------
# The container's own mount points, read by config.py. Leave these alone unless
# you are running the app outside Docker — they are NOT host paths.
VAULT_PATH=/vault
DATA_PATH=/data

# --- Host paths (read by docker-compose.yml only) -------------------------
# The vault directory ON YOUR MACHINE, bind-mounted to /vault in the container.
# Unset → ./sample_vault. Must be a host path; pointing it at /vault mounts an
# empty directory and the index comes up empty.
# HOST_VAULT_PATH=G:/My Drive/Obsidian

# --- Qdrant / Redis / SQLite (defaults are the in-container services) -----
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=obsidian_librarian
REDIS_URL=redis://127.0.0.1:6379/0
SQLITE_PATH=/data/librarian.db

# --- Chunking / retrieval -------------------------------------------------
CHUNK_SIZE=512
CHUNK_OVERLAP=64
RETRIEVAL_TOP_N=20
RERANK_TOP_K=6

# --- RAG-MCP (read-only, agent-only) --------------------------------------
RAG_MCP_HOST=127.0.0.1
RAG_MCP_PORT=8765

# --- Agent ----------------------------------------------------------------
RECURSION_LIMIT=12
WRITE_CONFIRM=true

# --- Obsidian Local REST API plugin MCP (writes) --------------------------
OBSIDIAN_MCP_URL=https://host.docker.internal:27124/mcp/
OBSIDIAN_API_KEY=replace-me
OBSIDIAN_TLS_INSECURE=true

# --- FastAPI (Seam 2) -----------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000

# --- APScheduler ----------------------------------------------------------
SYNC_INTERVAL_MINUTES=15
SYNC_ON_START=true

# --- Langfuse (agent ONLY — never the pipeline) ---------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Advanced / optional --------------------------------------------------
# Sensible defaults are baked into config.py; uncomment only to override.
# Lines marked "do not change" are tightly coupled to other components.

# Embedding vector width for nomic-embed-text. Must match the model (768 for nomic).
# Changing this requires dropping + re-creating the Qdrant collection (re-sync).
# EMBED_DIM=768

# Generation + judge LLM tuning (apply to deepseek-v4-pro:cloud / glm-5.2:cloud).
# LLM_TEMPERATURE=0.2
# LLM_REQUEST_TIMEOUT=120.0

# Timeout for one local-Ollama embedding call. High on purpose: the first embed after a
# container start pays a cold model load (~274 MB + CPU runner spin-up) that overran the old
# 60s budget and made the first sync fail with "timed out". Steady-state embeds are sub-second.
# EMBED_REQUEST_TIMEOUT=300.0

# Allowed CORS origins for the OpenAI-compatible endpoint, comma-separated. Empty (default)
# restricts to localhost loopback on any port. The endpoint is unauthenticated and
# write-capable, so "*" is unsafe without network-level isolation.
# API_CORS_ORIGINS=

# Where fastembed caches its ONNX models (BM25 sparse + cross-encoder rerank). Defaults onto
# the persistent /data volume so they download once, not on every container recreation.
# FASTEMBED_CACHE_PATH=/data/caches/fastembed

# Qdrant API key (only if your Qdrant instance has auth enabled; in-container it does not).
# QDRANT_API_KEY=

# Redis namespace for the raw docstore + node store + dedup hash set.
# REDIS_DOCSTORE_NAMESPACE=librarian/docstore

# Rerank + sparse (BM25) ONNX models used by fastembed. Pin a HuggingFace id
# (reranker) or a Qdrant sparse model name (BM25). Do not change unless you
# know the replacement is API-compatible.
# RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
# SPARSE_MODEL=Qdrant/bm25

# nomic-embed-text instruction prefixes. Do NOT change — nomic requires these
# exact prefixes ("search_document: " / "search_query: ", each with a trailing
# space) to distinguish index vs. query inputs; mismatched prefixes silently
# degrade retrieval quality. Keep the quotes: dotenv strips trailing whitespace
# from unquoted values, which would drop the load-bearing space.
# EMBED_DOC_PREFIX="search_document: "
# EMBED_QUERY_PREFIX="search_query: "

# HTTP path the RAG-MCP read server listens on. Must match rag_server.py.
# RAG_MCP_PATH=/mcp

# The propose-then-confirm marker the agent emits before a write, and that the
# agent eval + any guard looks for. Do not change unless you also update the
# eval expectations and the Obsidian skill file.
# PENDING_WRITE_MARKER=[PENDING_WRITE]

# Default thread id for the checkpointer when a chat request carries no opener
# (so pending writes can still carry across turns).
# API_DEFAULT_THREAD_ID=obsidian-librarian-default